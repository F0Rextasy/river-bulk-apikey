{
  "name": "river-bulk-apikey",
  "version": "1.0.0",
  "description": "Bulk-create River AI (console.river.ai) accounts with auto-generated API keys, driven through a real (cloud) browser over CDP. Zero dependencies.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "river-bulk": "src/cli.js",
    "river-bulk-launcher": "src/launcher.js"
  },
  "main": "src/river.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/launcher.js",
    "mint": "node src/cli.js",
    "create": "node src/cli.js --count 1",
    "9router": "node src/connect-9router.js",
    "connect-9router": "node src/connect-9router.js",
    "selftest": "node tools/fivesim-selftest.js"
  },
  "keywords": [
    "api-key",
    "bulk",
    "register",
    "launcher",
    "river-ai",
    "river",
    "apikey"
  ],
  "files": [
    "src",
    "docs",
    "examples",
    "i18n",
    "brand",
    "README.md",
    "LICENSE"
  ]
}
